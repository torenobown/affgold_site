# AFFGOLD production rules for affgoldprod.com (Apache/Beget).
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Keep the first-party project redirect that existed before this release.
  RewriteRule ^velora/?$ https://luminous-stride.com/svpm9qq3e [R=301,L,NE,QSD]

  # These public sections were removed. Return 410 even if stale files remain
  # after an incremental upload to the hosting directory.
  RewriteRule ^about/(?:affiliate-disclosure|responsible-play)(?:/.*)?$ - [G,L,NC]

  # Defence in depth: keep local editor/build files private even if stale files
  # accidentally remain in the hosting directory after an incremental upload.
  RewriteRule ^(?:admin|content|node_modules|scripts|\.git|\.github)(?:/|$) - [R=404,L,NC]
  RewriteRule ^(?:js/(?:admin|projects-data)\.js|css/admin\.css|package(?:-lock)?\.json|README\.txt|\.nvmrc|\.node-version|(?:build-beget|open-editor|rebuild-site)\.bat)$ - [R=404,L,NC]

  # AFFGOLD:PROJECT_REDIRECTS:START
  # Query and redirectAliases rules are inserted into the release copy.
  # AFFGOLD:PROJECT_REDIRECTS:END

  # Legacy sections were replaced by consolidated evergreen pages.
  RewriteRule ^compare(?:/.*)?$ https://affgoldprod.com/catalog.html [R=301,L,NE,QSD]
  RewriteRule ^news(?:/.*)?$ https://affgoldprod.com/bonuses/ [R=301,L,NE,QSD]
  RewriteRule ^updates(?:/.*)?$ https://affgoldprod.com/about/methodology/ [R=301,L,NE,QSD]

  # Avoid a duplicate homepage URL when /index.html is requested explicitly.
  RewriteCond %{THE_REQUEST} \s/+index\.html(?:[?\s]) [NC]
  RewriteRule ^index\.html$ https://affgoldprod.com/ [R=301,L,NE,QSD]

  # One canonical origin: HTTPS and the non-www host. The proxy condition avoids
  # redirect loops when Apache receives HTTPS requests from a reverse proxy.
  RewriteCond %{HTTP_HOST} !^affgoldprod\.com$ [NC]
  RewriteRule ^ https://affgoldprod.com%{REQUEST_URI} [R=301,L,NE]

  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
  RewriteRule ^ https://affgoldprod.com%{REQUEST_URI} [R=301,L,NE]
</IfModule>

<IfModule mod_headers.c>
  Header always unset X-Powered-By
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=(), usb=()"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; frame-src 'none'; upgrade-insecure-requests"

  <FilesMatch "\.(?:css|js|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(?:avif|webp|png|jpe?g|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000, stale-while-revalidate=86400"
  </FilesMatch>
  <FilesMatch "\.(?:html|xml|txt)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <Files "404.html">
    Header always set Cache-Control "no-store"
  </Files>
  <Files "release-manifest.json">
    Header always set Cache-Control "no-store"
    Header always set X-Robots-Tag "noindex, nofollow"
  </Files>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xml "access plus 0 seconds"
  ExpiresByType text/plain "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/avif "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json application/xml image/svg+xml
</IfModule>
