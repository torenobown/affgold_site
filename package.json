{
  "name": "affgold-site",
  "version": "1.0.0",
  "private": true,
  "description": "Статическая сборка каталога и обзоров AFFGOLD",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "test": "npm run test:data && npm run test:release",
    "test:data": "node scripts/test-project-data-contract.mjs",
    "test:release": "node scripts/test-release-zip.mjs",
    "build": "node scripts/build-seo.mjs",
    "build:css": "node scripts/build-css.mjs",
    "check": "node scripts/check-site.mjs",
    "package:beget": "node scripts/build-beget.mjs && node scripts/create-release-zip.mjs",
    "release:check": "node scripts/check-release.mjs",
    "release": "npm test && npm run build && npm run check && npm run package:beget && npm run release:check",
    "smoke": "node scripts/check-release.mjs",
    "smoke:live": "node scripts/smoke-live.mjs"
  }
}
